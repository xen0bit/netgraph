[Unit]
Description=netgraph host agent (name the programs behind this host's connections)
Documentation=https://github.com/xen0bit/netgraph/blob/main/docs/agent.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
EnvironmentFile=/etc/netgraph/agent.conf
# The token file stays root-only; systemd hands the dynamic user a copy.
LoadCredential=token:/etc/netgraph/agent.token
ExecStart=/usr/bin/netgraph-agent -token-file ${CREDENTIALS_DIRECTORY}/token $NETGRAPH_AGENT_ARGS
Restart=on-failure
RestartSec=5s
DynamicUser=yes
# Another user's /proc/<pid>/fd and exe need CAP_SYS_PTRACE (read access to
# /proc only: the agent never attaches to a process) and CAP_DAC_READ_SEARCH.
# Enforcement (-enforce=nftables -apply) also needs CAP_NET_ADMIN: add it to
# AmbientCapabilities with systemctl edit netgraph-agent.
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_NET_ADMIN
AmbientCapabilities=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax=256M

[Install]
WantedBy=multi-user.target
