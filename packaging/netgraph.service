[Unit]
Description=netgraph server (ingest, storage, API and web UI)
Documentation=https://github.com/xen0bit/netgraph
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
EnvironmentFile=/etc/netgraph/server.conf
# Token and key files stay root-only; systemd hands the dynamic user copies.
# The directory credential copies every file in /etc/netgraph as etc_<name>,
# so the optional read.token, wifi.keys and tls.crt/tls.key need no flag and
# no unit line: netgraph serve uses each one present. (A missing file named
# in its own LoadCredential= line would stop the unit from starting.)
LoadCredential=token:/etc/netgraph/server.token
LoadCredential=etc:/etc/netgraph
ExecStart=/usr/bin/netgraph serve -db /var/lib/netgraph/netgraph.db -token-file ${CREDENTIALS_DIRECTORY}/token $NETGRAPH_SERVER_ARGS
Restart=on-failure
RestartSec=2s
DynamicUser=yes
StateDirectory=netgraph
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
