[Unit]
Description=netgraph server (ingest, storage, API and web UI)
Documentation=https://github.com/xen0bit/netgraph
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
EnvironmentFile=/etc/netgraph/server.conf
ExecStart=/usr/bin/netgraph serve -db /var/lib/netgraph/netgraph.db $NETGRAPH_SERVER_ARGS
Restart=on-failure
RestartSec=2s
DynamicUser=yes
StateDirectory=netgraph
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
