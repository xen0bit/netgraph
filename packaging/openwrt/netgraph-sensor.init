#!/bin/sh /etc/rc.common
# procd init script for OpenWrt. Install as /etc/init.d/netgraph-sensor with
# the binary at /usr/bin/netgraph-sensor, then:
#   uci set netgraph.sensor.server='https://netgraph.lan:8443'; uci commit netgraph
#   /etc/init.d/netgraph-sensor enable && /etc/init.d/netgraph-sensor start

USE_PROCD=1
START=95
STOP=10

start_service() {
	config_load netgraph
	local iface server token_file wifi_key_file wifi_hop wifi_channels
	config_get iface sensor iface br-lan
	config_get server sensor server
	config_get token_file sensor token_file /etc/netgraph/sensor.token
	config_get wifi_key_file sensor wifi_key_file
	config_get_bool wifi_hop sensor wifi_hop 0
	config_get wifi_channels sensor wifi_channels
	[ -n "$server" ] || { echo "netgraph.sensor.server is not set" >&2; return 1; }

	set -- /usr/bin/netgraph-sensor run -iface "$iface" -server "$server" -token-file "$token_file"
	[ -n "$wifi_key_file" ] && set -- "$@" -wifi-key-file "$wifi_key_file"
	[ "$wifi_hop" = 1 ] && set -- "$@" -wifi-hop
	[ -n "$wifi_channels" ] && set -- "$@" -wifi-channels "$wifi_channels"

	procd_open_instance
	procd_set_param command "$@"
	procd_set_param env GOMEMLIMIT=128MiB
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
